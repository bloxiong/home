{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/products/agrosense360",
      "has": [
        {
          "type": "host",
          "value": "bloxio.tech"
        }
      ],
      "destination": "https://agrosense360.bloxio.tech/",
      "permanent": true
    },
    {
      "source": "/products/agrosense360/survey",
      "has": [
        {
          "type": "host",
          "value": "bloxio.tech"
        }
      ],
      "destination": "https://agrosense360.bloxio.tech/survey",
      "permanent": true
    },
    {
      "source": "/products/agrosense360",
      "has": [
        {
          "type": "host",
          "value": "www.bloxio.tech"
        }
      ],
      "destination": "https://agrosense360.bloxio.tech/",
      "permanent": true
    },
    {
      "source": "/products/agrosense360/survey",
      "has": [
        {
          "type": "host",
          "value": "www.bloxio.tech"
        }
      ],
      "destination": "https://agrosense360.bloxio.tech/survey",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
